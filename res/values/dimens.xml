<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Side bar width at the 1920x720@160dpi baseline: 14.6% of the screen width, leaving
         1639dp for the content area (two 1:1 slots of ~819x720dp). Still workable down to
         1280x720 (22%, 1000dp content). Extracted so a sw-specific override can be added
         without touching the layout. -->
    <dimen name="sidebar_width">280dp</dimen>

    <!-- Side bar row geometry, sized for head-unit viewing distance (~60cm) at 160dpi:
         a 56dp icon (~8.9mm) and 12dp vertical padding give an 80dp row, a comfortable
         touch target with ~9 rows visible on a 720dp-tall screen. -->
    <dimen name="app_icon_size">56dp</dimen>
    <dimen name="app_row_padding">12dp</dimen>

    <!-- Content slot geometry: the container outline and the selection ring are rounded at
         slot_corner_radius; the embedded content is inset by slot_border_padding (the ring
         area, also the container's touch target for slot selection), so its own corner
         radius is slot_corner_radius - slot_border_padding to stay concentric with the ring
         (computed in LauncherActivity). The ring is deliberately a bit heavier than a hairline
         (4dp stroke + 1dp separation): it is the glanceable selected-slot indicator and the
         only clickable band around an occupied slot. -->
    <dimen name="slot_corner_radius">12dp</dimen>
    <dimen name="slot_border_width">4dp</dimen>
    <dimen name="slot_border_padding">5dp</dimen>
</resources>
