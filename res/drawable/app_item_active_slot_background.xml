<?xml version="1.0" encoding="utf-8"?>
<!-- Stronger side bar highlight for the app embedded in the currently selected slot; the app
     embedded in the other slot keeps the plain app_item_selected_background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#3D6688CC" />
    <stroke
        android:width="1dp"
        android:color="#FF8AB4F8" />
    <corners android:radius="8dp" />
</shape>
